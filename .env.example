# NextAuth / GitHub OAuth
# For local development:
# NEXTAUTH_URL=http://localhost:3000
# For production:
# NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_URL=
NEXTAUTH_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# Real-time battle socket server URL consumed by client
# Local: http://localhost:3001
# Prod:  https://battle.your-domain.com
NEXT_PUBLIC_SOCKET_URL=

# Socket server runtime env (used when running `npm run socket`)
# CLIENT_ORIGIN should be your web app origin (no trailing slash)
CLIENT_ORIGIN=
